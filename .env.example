# Порт веб-интерфейса (по умолчанию 5335)
PORT=5335

# Сколько последних URL хранить в истории (по умолчанию 20)
HISTORY_SIZE=20

# Ключ шифрования истории (32 байта в base64 или 64 символа hex). Если задан, в data/history.json
# шифруются: пароль и client secret Keycloak, заголовок Authorization.
# Сгенерировать ключ: openssl rand -base64 32
# HISTORY_ENCRYPTION_KEY=<base64 или hex>
